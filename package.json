{
  "name": "crm-sicoven",
  "version": "0.2.0",
  "private": true,
  "description": "CRM privado en la nube para clientes, productos y licencias SICOVEN",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "desktop:dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.9",
    "typescript": "^5.9.3",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.efasfreelancer.crm-sicoven",
    "productName": "CRM SICOVEN",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM SICOVEN"
    },
    "artifactName": "CRM-SICOVEN-Setup-${version}-${arch}.${ext}"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true,
    "unrs-resolver@1.12.2": true
  }
}
